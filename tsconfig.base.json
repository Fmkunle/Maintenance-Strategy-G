{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@maint/contracts": ["packages/contracts/src/index.ts"],
      "@maint/contracts/*": ["packages/contracts/src/*"],
      "@maint/domain": ["packages/domain/src/index.ts"],
      "@maint/domain/*": ["packages/domain/src/*"],
      "@maint/shared": ["packages/shared/src/index.ts"],
      "@maint/shared/*": ["packages/shared/src/*"]
    }
  }
}
